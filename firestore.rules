rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: Allow read and write for store operations
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Live OTP Sessions: Real-time checkout authentication & admin approval
    match /otp_sessions/{sessionId} {
      allow read, write: if true;
    }
    
    // Products catalog: Allow read and update by store admin
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Settings & Configuration
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Fallback rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
